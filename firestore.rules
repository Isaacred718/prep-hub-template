// Firestore security rules for the study apps (reference copy — not deployed
// with the site). Paste the blocks below into Firebase console → Firestore →
// Rules for the lift-tracker-fade7 project, NEXT TO the existing fitlog rules.
// Don't replace the whole ruleset: the fitlog app's users/{uid} rules must stay.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CTS Prep: one progress doc per signed-in user, readable and writable
    // only by that user.
    match /cts_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Every study app built from the template (topic.js sync.collection is
    // "<id>_users", e.g. astro_users, spanish_users). This one block covers
    // all of them; it also covers cts_users, which makes the block above
    // redundant but harmless.
    match /{collection}/{uid} {
      allow read, write: if collection.matches('[a-z][a-z0-9-]*_users')
                         && request.auth != null && request.auth.uid == uid;
    }

    // ... existing fitlog-tracker rules stay here ...
  }
}
